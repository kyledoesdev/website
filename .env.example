APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lifeos
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_STORE=database
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1

# Queue & storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
FAILURE_EMAIL=

# Frontend
VITE_APP_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=
AWS_URL=

# OAuth
CONNECTION_REDIRECT='/connection/callback'

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# TMDB
MOVIEDB_API_KEY=
MOVIEDB_KEY=

# Steam
STEAM_API_KEY=
STEAM_ID=

# Geocoding - dash.geocod.io/apikey
GEOCODIO_API_KEY=

# Discord - Royalty
DISCORD_ROYALTY_BEANS_WEBHOOK_URL=
DISCORD_ROYALTY_WEATHERREPORT_WEBHOOK_URL=
DISCORD_ROYALTY_BEANS_ROLE_ID=

# Discord - Song Rank
DISCORD_SONGRANK_LIVENOW_WEBHOOK_URL=
DISCORD_SONGRANK_INTERNALUPDATES_WEBHOOK_URL=
LOG_DISCORD_IGNORE_EXCEPTIONS=false

# Essentials
LOCAL_ENVS=local
TIMEZONE_RETRY_AFTER=300
TIMEZONE_CACHE_TTL=86400
